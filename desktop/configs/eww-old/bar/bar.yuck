(include "./bar/left/left.yuck")
(include "./bar/right/right.yuck")
(include "./bar/bar-clock/bar-clock.yuck")


;; ============== ;;
;; Отдел виджетов ;;
;; ============== ;;
; Верхнее меню
(defwidget bar []
	(centerbox
	    :class "bar"
		:orientation "h"

		(left)
		(box)
		(right)
))

; Верхнее меню
(defwidget clock []
	(box
	    :class "bar-clock"
		:orientation "h"

		(center-clock)
))

;; ========== ;;
;; Отдел окон ;;
;; ============= ;;
(defwindow bar
    :monitor 0
    :geometry (
        geometry :x "0%"
        :y "10px"
        :width "98%"
        :height "40px"
        :anchor "top center"
    )
    :exclusive true
    :stacking "fg"
    :reserve (struts :distance "50px" :side "top")

    (bar)
)

(defwindow bar-clock
    :monitor 0
    :geometry (
        geometry
        :y "-45px"
        :height "40px"
        :anchor "top center"
    )
    :wm-ignore true
    :stacking "overlay"

    (clock)
)
