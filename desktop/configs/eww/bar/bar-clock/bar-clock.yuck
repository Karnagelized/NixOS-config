;; ======================================== ;;
;; Переменные и слушатели центрального меню ;;
;; ======================================== ;;
(defpoll current_time :interval "1s" "date '+%H:%M'")
(defpoll current_seconds :interval "1s" "date '+:%S'")


;; =============================== ;;
;; Центральная часть верхнего меню ;;
;; =============================== ;;
(defwidget center-clock []
	(box
	    :class "bar-center"
		:space-evenly false
		:halign "center"

			(eventbox
			    :class "center-clock"

				(box
			        :space-evenly false

					(label
				        :text current_time
				    )
				    (label
				        :class "center-clock-seconds"
				        :text current_seconds
)))))
