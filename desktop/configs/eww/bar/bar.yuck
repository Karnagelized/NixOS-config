;; ========== ;;
;; Отдел окон ;;
;; ============= ;;
(defwindow bar
    :monitor 0
    :geometry (
        geometry :x "0%"
        :y "10px"
        :width "98%"
        :height "40px"
        :anchor "top center"
    )
    :exclusive true
    :stacking "fg"
    :reserve (struts :distance "40px" :side "top")
    :wm-ignore false
(bar))
