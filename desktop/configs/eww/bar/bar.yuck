(include "./bar/left/left.yuck")
(include "./bar/center/center.yuck")
(include "./bar/right/right.yuck")


;; ============== ;;
;; Отдел виджетов ;;
;; ============== ;;
; Верхнее меню
(defwidget bar []
	(centerbox
	    :class "bar"
		:orientation "h"
		(left)
		(center)
		(right)
))


;; ========== ;;
;; Отдел окон ;;
;; ============= ;;
(defwindow bar
    :monitor 0
    :geometry (
        geometry :x "0%"
        :y "10px"
        :width "98%"
        :height "40px"
        :anchor "top center"
    )
    :exclusive true
    :stacking "fg"
    :reserve (struts :distance "40px" :side "top")
    :wm-ignore false
(bar))
