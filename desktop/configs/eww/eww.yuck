(defpoll clock :interval "10s" "date '+%H:%M'")

(defwidget bar []
  (centerbox :orientation "h" :class "bar"
    (box :halign "start" "")
    (box :halign "center" "Hyprland")
    (box :halign "end" clock)))

(defwindow bar
  :monitor 0
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "100%"
    :height "32px"
    :anchor "top center")
  :stacking "fg"
  :exclusive true
  (bar))